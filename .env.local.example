# Copy this file to .env.local and fill in your keys. Never commit .env.local.
#
# Get a free key at https://aistudio.google.com/apikey (Google AI Studio)
# Without this, the AI tab (맥락 해설 / 청소년 설교 스케치) falls back to a
# small set of demo responses for Genesis 1:1, John 3:16, Psalm 23:1, and
# Ezra 9:13 — every other verse shows a "no demo yet" message instead.
GEMINI_API_KEY=

# Create a free project at https://supabase.com, then Project Settings > API.
# Without these, login/notes show a "설정이 필요해요" message instead of a form.
# Also run supabase/schema.sql once in the Supabase SQL Editor to create the
# notes table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
